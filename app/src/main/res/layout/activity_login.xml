<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B0B0E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JARVIS"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp"/>

        <EditText
            android:id="@+id/emailField"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Email"
            android:textColor="#FFFFFF"
            android:textColorHint="#888"
            android:background="@drawable/bg_input"
            android:paddingStart="20dp"
            android:layout_marginBottom="16dp"
            android:inputType="textEmailAddress"/>

        <EditText
            android:id="@+id/passwordField"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Пароль (мин. 6 символов)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888"
            android:background="@drawable/bg_input"
            android:paddingStart="20dp"
            android:layout_marginBottom="24dp"
            android:inputType="textPassword"/>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Войти"
            android:backgroundTint="#5B5BFF"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Зарегистрироваться"
            android:backgroundTint="#2A2A35"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Или"
            android:textColor="#888"
            android:layout_marginBottom="16dp"/>

        <!-- ВОЗВРАЩАЕМ КНОПКУ GOOGLE -->
        <Button
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Войти через Google"
            android:backgroundTint="#DB4437"
            android:layout_marginBottom="32dp"/>
    </LinearLayout>
</ScrollView>
