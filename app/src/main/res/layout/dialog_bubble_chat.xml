<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_glass">

    <TextView
        android:id="@+id/tvBubbleTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jarvis"
        android:textColor="#2DD4BF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvBubbleAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"/>

    <EditText
        android:id="@+id/etBubbleInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Задать вопрос..."
        android:textColor="#FFFFFF"
        android:textColorHint="#777777"
        android:background="@drawable/bg_input"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="text"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnBubbleSend"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Отправить"
        android:backgroundTint="#2DD4BF"
        android:textColor="#000000"/>
</LinearLayout>
